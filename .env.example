# Demo defaults — no API keys required
POSTGRES_USER=aimp
POSTGRES_PASSWORD=aimp
POSTGRES_DB=aimp
DATABASE_URL=postgresql+psycopg2://aimp:aimp@postgres:5432/aimp
REDIS_URL=redis://redis:6379/0
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
JWT_SECRET=aimp-demo-secret-change-in-prod
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
SEED_EVENT_COUNT=100000
ENVIRONMENT=demo
